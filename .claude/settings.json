{
  "permissions": {
    "allow": ["Bash(./init.sh)", "Bash(./init.sh --quick)"],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./local.properties)"],
    "additionalDirectories": ["../asclepio-api/docs", "../asclepio-api/openapi"]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-api-readonly.sh" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop.sh" }] }
    ]
  }
}
