{
  "name": "asclepio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:compile && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write src",
    "typecheck": "npm run i18n:compile && tsc -b --noEmit",
    "test": "npm run i18n:compile && vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript ../asclepio-api/openapi/asclepio-api.v1.json -o src/shared/api/schema.d.ts",
    "i18n:check": "node scripts/check-messages.mjs",
    "i18n:compile": "node scripts/compile-messages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/plugin-message-format": "^4.5.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "openapi-fetch": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.9.2",
    "@inlang/paraglide-js": "^2.29.3",
    "@tanstack/react-query": "^5.105.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  }
}
